[Unit]
Description=Refresh the Claude usage-limits cache (~/.cache/claude_usage_limits.json) without a status-line render
ConditionPathExists=%h/.claude/.credentials.json

[Service]
Type=oneshot
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh -c "echo '{}' | %h/.claude/statusline.sh >/dev/null"
