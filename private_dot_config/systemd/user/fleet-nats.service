[Unit]
Description=NATS JetStream hub for the fleet agent chat (port 4222)

[Service]
# exec the real binary (resolved by mise at every start, so a mise upgrade takes
# effect at the next restart): the main PID must be nats-server itself for HUP
# (config reload) and stop to reach it, not a shim in front of it
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh -c 'exec "$(mise which nats-server)" -c %h/.config/nats/nats.conf'
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
