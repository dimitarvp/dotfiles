#!/bin/sh
# Rejects a commit message that breaks this repository's format: a subject of
# up to 50 characters that does not start with a capital letter, body lines of
# up to 72 characters, no trailer or attribution lines.
# Once per clone: git config core.hooksPath .githooks
awk '
/^#/ { next }
!seen {
	seen = 1
	if (length($0) > 50) { printf "subject: %d characters, the limit is 50\n", length($0); bad = 1 }
	if ($0 ~ /^[A-Z]/ && $0 !~ /^Revert "/) { print "subject: starts with a capital letter"; bad = 1 }
	next
}
length($0) > 72 { printf "line %d: %d characters, the limit is 72\n", NR, length($0); bad = 1 }
tolower($0) ~ /^(co-authored-by|signed-off-by|claude-session|generated with|🤖)/ { printf "line %d: a trailer or attribution line\n", NR; bad = 1 }
END { exit bad }
' "$1" >&2 || {
	echo "commit message rejected (format: subject up to 50, body wrapped at 72, no trailers)" >&2
	exit 1
}
