[tools]
erlang = ["29", "28.5.0", "27"]
elixir = ["1.20", "1.19", "1.18"]
go = "latest"
node = "latest"
pandoc = "latest"
pnpm = "10.7.0" # exact pin on purpose
rebar = "latest"
"aqua:google-antigravity/antigravity-cli" = "latest"
"github:Ataraxy-Labs/inspect" = "latest"
{{- if ne .chezmoi.os "darwin" }}
"aqua:remoteoss/dexter" = "latest"
{{- end }}
{{- if ne .role "server" }}

# OpenObserve publishes GitHub releases WITHOUT binary assets (tags only), so the
# github: backend can't fetch it; binaries live on downloads.openobserve.ai.
# Versions come from the releases API; version_order sorts them semver-wise
# (the API returns newest-first and mise takes the LAST entry as latest).
# Prereleases (-rc) are dropped by mise itself.
[tools."http:openobserve"]
version = "latest"
version_order = "semver"
version_list_url = "https://api.github.com/repos/openobserve/openobserve/releases"
version_json_path = ".[].tag_name"
[tools."http:openobserve".platforms]
linux-x64 = { url = "https://downloads.openobserve.ai/releases/openobserve/v{{ "{{version}}" }}/openobserve-v{{ "{{version}}" }}-linux-amd64.tar.gz" }
macos-x64 = { url = "https://downloads.openobserve.ai/releases/openobserve/v{{ "{{version}}" }}/openobserve-v{{ "{{version}}" }}-darwin-amd64.tar.gz" }
macos-arm64 = { url = "https://downloads.openobserve.ai/releases/openobserve/v{{ "{{version}}" }}/openobserve-v{{ "{{version}}" }}-darwin-arm64.tar.gz" }
{{- end }}

[env]
# antigravity-cli self-updates in place by default, fighting mise/aqua
# ownership (it bumped 1.1.5→1.1.7 within minutes of first run); disable so
# converge is the only updater. Undocumented but embedded in the binary.
AGY_CLI_DISABLE_AUTO_UPDATE = "1"

[settings]
# make mise honor repos' .nvmrc/.node-version (opt-in in current mise);
# node only — keeps the blast radius minimal
idiomatic_version_file_enable_tools = ["node"]
# do NOT export GOROOT: a stale exported value (shell predating a go-version
# prune) poisons child processes incl. mise's own post-install `go version`
# check (how robeast's 1.27 upgrade blew up). go self-derives GOROOT.
go_set_goroot = false

[tasks.converge]
description = "Install, upgrade, and prune tools"
# http:* installs are symlinks into ~/.local/share/mise/http-tarballs/<sha256>/;
# prune removes the symlink only, so orphaned content is reaped afterwards.
run = "mise install && mise upgrade && mise prune -y && mise_reap_http_tarballs"
