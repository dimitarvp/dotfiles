<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Time Machine and other low-priority I/O run at full speed: the kernel's low-priority throttle is off from boot. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dimi.disable_disk_throttling</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/sbin/sysctl</string>
		<string>-w</string>
		<string>debug.lowpri_throttle_enabled=0</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
