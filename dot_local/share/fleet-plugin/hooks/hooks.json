{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "id=$FLEET_NAME; [ -n \"$id\" ] || id=$(cat \"${CLAUDE_PROJECT_DIR}/.fleet-identity\" 2>/dev/null); [ -z \"$id\" ] || fleet \"$id\" release"
          }
        ]
      }
    ]
  }
}
