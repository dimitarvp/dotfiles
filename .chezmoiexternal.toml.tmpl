# Externals: content chezmoi fetches from outside this repo and keeps in $HOME.
# git-repo entries are cloned once and `git pull`ed on apply, at most once per
# refreshPeriod (force with `chezmoi apply -R`) — the daily update_all apply is
# the update lane for from-source tools that publish no releases.
{{- if ne .role "server" }}

# probex — AST queries over Elixir source for coding agents (alpha, no releases).
# --rebase: we never commit here, so a force-push upstream just gets followed.
["bin/probex"]
    type = "git-repo"
    url = "https://github.com/pnezis/probex.git"
    refreshPeriod = "24h"
    [ "bin/probex".pull ]
        args = ["--rebase", "--autostash"]

# unison — the wsync engine. Version-PINNED on purpose: unison's sync-state
# archives are compatibility-sensitive, so a bump is deliberate (new URL+path
# here on all machines, then re-run the wsync gauntlet). No refreshPeriod:
# a pinned release URL never changes, the cached download is final.
{{- if eq .chezmoi.os "darwin" }}
[".local/bin/unison"]
    type = "archive-file"
    url = "https://github.com/bcpierce00/unison/releases/download/v2.54.0/unison-2.54.0-macos-x86-64.tar.gz"
    path = "unison-2.54.0-macos-x86-64/bin/unison"
    executable = true
{{- else }}
[".local/bin/unison"]
    type = "archive-file"
    url = "https://github.com/bcpierce00/unison/releases/download/v2.54.0/unison-2.54.0-ubuntu-22.04-x86_64-static.tar.gz"
    path = "unison-2.54.0-ubuntu-22.04-x86_64-static/bin/unison"
    executable = true
{{- end }}
{{- end }}
