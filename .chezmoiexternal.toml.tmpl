# Externals: content chezmoi fetches from outside this repo and keeps in $HOME.
# git-repo entries are cloned once and `git pull`ed on apply, at most once per
# refreshPeriod (force with `chezmoi apply -R`) — the daily update_all apply is
# the update lane for from-source tools that publish no releases.
{{- if ne .role "server" }}

# probex — AST queries over Elixir source for coding agents (alpha, no releases).
# --rebase: we never commit here, so a force-push upstream just gets followed.
["bin/probex"]
    type = "git-repo"
    url = "https://github.com/pnezis/probex.git"
    refreshPeriod = "24h"
    [ "bin/probex".pull ]
        args = ["--rebase", "--autostash"]

{{- end }}
{{- if eq .chezmoi.os "darwin" }}

# Single-file tools on the Mac, taken from their upstream releases (no package
# manager builds them as binaries); the version sits in the URL, bump by hand.
# ack — grep for programmers, one Perl script.
[".local/bin/ack"]
    type = "file"
    url = "https://beyondgrep.com/ack-v3.10.0"
    executable = true
# timedog — sizes of Time Machine backups, one Perl script.
[".local/bin/timedog"]
    type = "file"
    url = "https://raw.githubusercontent.com/nlfiedler/timedog/v1.4/timedog"
    executable = true
# sqlite3_rsync — the official sqlite.org x64 tools build, one file out of the zip.
[".local/bin/sqlite3_rsync"]
    type = "archive-file"
    url = "https://sqlite.org/2026/sqlite-tools-osx-x64-3540100.zip"
    path = "sqlite3_rsync"
    executable = true
# rrsync — restricted rsync for authorized_keys command= lines; rsync's own support
# script, which the MacPorts rsync port does not install.
[".local/bin/rrsync"]
    type = "file"
    url = "https://raw.githubusercontent.com/RsyncProject/rsync/v3.5.1/support/rrsync"
    executable = true

{{- end }}
