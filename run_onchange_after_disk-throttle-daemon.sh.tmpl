{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Installs the root launch daemon that turns the kernel's low-priority I/O throttle off at
# boot (Time Machine and other background I/O at full speed) and retires the two 2020 login
# agents whose programs no longer exist. Re-runs whenever the daemon's plist changes.
# daemon: {{ include "dot_local/share/launchd-reference/com.dimi.disable_disk_throttling.plist" | sha256sum }}
set -euo pipefail
label=com.dimi.disable_disk_throttling
src="$HOME/.local/share/launchd-reference/$label.plist"
dst="/Library/LaunchDaemons/$label.plist"
uid=$(id -u)
for old in com.dimi.disable_disk_throttling com.dimi.remount_noatime; do
	if launchctl print "gui/$uid/$old" >/dev/null 2>&1; then
		launchctl bootout "gui/$uid/$old" || true
	fi
	sudo -n rm -f "/Library/LaunchAgents/$old.plist"
done
if sudo -n launchctl print "system/$label" >/dev/null 2>&1; then
	sudo -n launchctl bootout "system/$label"
	# bootout tears the service down asynchronously; a bootstrap before it is gone fails
	for _ in $(seq 1 40); do
		sudo -n launchctl print "system/$label" >/dev/null 2>&1 || break
		sleep 0.25
	done
fi
sudo -n install -o root -g wheel -m 0644 "$src" "$dst"
sudo -n launchctl bootstrap system "$dst"
for _ in $(seq 1 20); do
	[ "$(sysctl -n debug.lowpri_throttle_enabled)" = 0 ] && break
	sleep 0.25
done
[ "$(sysctl -n debug.lowpri_throttle_enabled)" = 0 ] || {
	echo "disk-throttle daemon: debug.lowpri_throttle_enabled is still 1" >&2
	exit 1
}
echo "disk-throttle daemon: installed, low-priority I/O throttle off"
{{ else -}}
#!/bin/bash
: # macOS-only launch daemon — no-op on this machine
{{ end -}}
