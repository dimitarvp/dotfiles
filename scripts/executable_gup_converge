#!/bin/zsh
#
# gup_converge - Converge gup-managed Go tools to match the config
#
# 0. Build the locally built tools from their source directories
#    (~/.config/gup/local_sources, one directory per line)
# 1. Install only missing tools (compare gup list vs gup.json)
# 2. Update all installed tools to latest
# 3. Prune tools not in config
# 4. (removed: auto-export was dangerous — use gup_export manually)
#
# The source of truth is always ~/.config/gup/gup.json (managed by chezmoi)
#
# Failures are collected and reported at the end; one failing tool won't stop
# the rest (a tool whose repo is briefly unreachable must not block updates
# of the other 40).

set -uo pipefail

declare -a install_failures=()
declare -a local_failures=()
update_failed=false
prune_failed=false

eval "$(mise activate zsh --shims)"
export GOBIN="$HOME/go/bin"

CONFIG_FILE="${HOME}/.config/gup/gup.json"

if [[ ! -f "$CONFIG_FILE" ]]; then
	echo "ERROR: Config file not found: $CONFIG_FILE"
	echo "Run 'chezmoi apply' first to create it."
	exit 1
fi

echo "=== gup_converge ==="
echo "Config: $CONFIG_FILE"
echo ""

# 0. Locally built tools. gup cannot fetch them (see below), so each one is
# built from its source directory with `go install .`, which does nothing when
# the installed binary is current: a toolchain bump or a new machine needs no
# build by hand. The directories are listed in LOCAL_SOURCES, one per line (the
# file is kept encrypted in the repo: the paths are private). A directory that
# does not exist on this machine is named and skipped. This phase runs first,
# so that a tool built here for the first time is already known as local when
# the prune phase looks at what is installed.
LOCAL_SOURCES="${HOME}/.config/gup/local_sources"
if [[ -f "$LOCAL_SOURCES" ]]; then
	echo ">>> Phase 0: Building the local tools..."
	while IFS= read -r dir; do
		dir="${dir%%#*}"
		dir="${dir#"${dir%%[![:space:]]*}"}"
		dir="${dir%"${dir##*[![:space:]]}"}"
		[[ -z "$dir" ]] && continue
		dir="${dir/#\~/$HOME}"
		if [[ ! -d "$dir" ]]; then
			echo "[SKIP] $dir (not on this machine)"
			continue
		fi
		echo "[BUILD] $dir"
		if ! (cd "$dir" && go install .); then
			echo "[FAILED] $dir"
			local_failures+=("$dir")
		fi
	done <"$LOCAL_SOURCES"
	echo ""
fi

# Get sorted list of installed tool names
installed=$(gup list 2>/dev/null | awk -F: '{gsub(/^[ \t]+|[ \t]+$/, "", $1); print $1}' | sort)

# Locally built tools: a module path whose first element has no dot (e.g. "ccctx",
# built with `go install .` from ~/kod/ccctx) is not fetchable — `go install
# ccctx@latest` is impossible by Go's own rules — so gup can neither update nor
# reinstall it. gup leaves such tools alone: they are skipped in update and
# protected from prune; phase 0 above is what rebuilds them.
local_tools=("${(@f)$(gup list --json 2>/dev/null |
	jq -r '.[] | select(.import_path | split("/")[0] | test("\\.") | not) | .name' | sort)}")
local_tools=(${local_tools:#}) # drop the empty element a no-match yields
if (( ${#local_tools} )); then
	echo "Local (not fetchable, left alone by gup): ${local_tools[*]}"
	echo ""
fi

# Get sorted list of tool names from config
configured=$(jq -r '.packages[].name' "$CONFIG_FILE" | sort)

# 1. Install only missing tools
echo ">>> Phase 1: Installing missing tools..."
to_install=$(comm -23 <(echo "$configured") <(echo "$installed"))

if [[ -z "$to_install" ]]; then
	echo "Nothing to install. All configured tools are present."
else
	while IFS= read -r name; do
		# Look up import_path from the JSON
		import_path=$(jq -r --arg n "$name" '.packages[] | select(.name == $n) | .import_path' "$CONFIG_FILE")
		echo "[INSTALL] $name ($import_path@latest)"
		if ! go install "${import_path}@latest"; then
			echo "[FAILED] $name"
			install_failures+=("$name")
		fi
	done <<<"$to_install"
fi
echo ""

# 2. Update all installed tools to latest
echo ">>> Phase 2: Updating all tools to latest..."
update_args=()
(( ${#local_tools} )) && update_args=(--exclude "${(j:,:)local_tools}")
if ! gup update "${update_args[@]}"; then
	echo "[FAILED] update phase had errors (see above)"
	update_failed=true
fi
echo ""

# 3. Prune: remove tools not in config
echo ">>> Phase 3: Checking for tools to prune..."

# Re-fetch installed list after installs/updates
installed=$(gup list 2>/dev/null | awk -F: '{gsub(/^[ \t]+|[ \t]+$/, "", $1); print $1}' | sort)
to_prune=$(comm -23 <(echo "$installed") <(printf '%s\n' "$configured" "${local_tools[@]}" | sort))

if [[ -z "$to_prune" ]]; then
	echo "Nothing to prune."
else
	echo "Pruning:"
	echo "$to_prune"
	echo ""
	if ! echo "$to_prune" | xargs gup remove -f; then
		echo "[FAILED] prune had errors"
		prune_failed=true
	fi
fi
echo ""

# NOTE: do NOT auto-export here. If gup update fails, the config would be
# overwritten with only surviving tools. Run gup_export manually instead.
if (( ${#install_failures[@]} )) || (( ${#local_failures[@]} )) || [[ "$update_failed" == true ]] || [[ "$prune_failed" == true ]]; then
	echo "=== FAILURES ==="
	(( ${#local_failures[@]} )) && printf 'local build: %s\n' "${local_failures[@]}"
	(( ${#install_failures[@]} )) && printf 'install: %s\n' "${install_failures[@]}"
	[[ "$update_failed" == true ]] && echo "update phase had errors"
	[[ "$prune_failed" == true ]] && echo "prune had errors"
	exit 1
fi
echo "Done. Run gup_export manually if you added new tools."
