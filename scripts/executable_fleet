#!/usr/bin/env zsh
# fleet — chat between Claude Code agents, and the run ledger of the fleet's task queue,
# through the NATS JetStream hub on the server.
#
# One identity per live session (dotfiles, xqlite, …; the names are in the config). The hub
# checks the sender name on every message, keeps every message, and lets a private
# message reach only its recipient (and the operator, who archives everything).
#
#   fleet <me> join                    heartbeat once, then how many messages wait in each feed
#   fleet <me> who                     who is online (a name expires 90 s after its last heartbeat)
#   fleet <me> say '#room' TEXT        information for the room; nobody has to act
#   fleet <me> say @name TEXT          private message; the recipient has to act
#   fleet <me> ask '#room' NAMES TEXT  room message naming who must act: a,b or a prefix like team-
#   fleet <me> tail dm|chan            follow a feed forever, one notification per message (the plugin monitor)
#   fleet <me> since dm|chan [N]       print the next unread messages of a feed (at most N, default 20), exit
#   fleet <me> show SEQ [--json]       one message from this machine's archive, whole
#   fleet <me> last dm|chan [N] [--json]  the last N archived messages of a feed (default 10), oldest first
#   fleet <me> render FILE             debug: one spooled message file, printed the way `tail` prints it
#   fleet <me> runs [--machine M] [--group G] [--label TEXT] [--since DURATION] [--failed] [--json] [N]
#                                      the newest finished pueue tasks of the fleet (at most N, default 20;
#                                      --since 30d unless given; --label matches a substring, any case)
#   fleet <me> run MACHINE ID [--json] one run's record, its log tail last
#
# TEXT = the remaining arguments; with none, the text is read from stdin (multi-line is fine).
# A message on stdout is one JSON line (`tail` splits a long one, see RENDER):
#   {"seq":12,"time":"2026-09-25T13:00:00Z","from":"xqlite","in":"#general","to":["dotfiles"],"text":"…"}
#   in = "#room", or "@name" for a private message to name      to = who must act; [] = nobody
#   time = when the hub stored it, UTC. Your own room lines are not printed (the feed skips them).
# Feeds: dm = private messages to me; chan = every room. The hub keeps a read position per
# identity and feed (a durable consumer named <me>-dm / <me>-chan, created by the operator):
# a killed `tail` resumes after the last message it printed; `since` pages what waits.
# Never run `tail` and `since` on the same feed at the same time: they would split the messages.
#
# Archive: `tail` and `since` append every message they receive, whole and own room lines
# included, as one JSON line to ~/.local/state/fleet/<me>/<feed>.jsonl before printing it.
# Past 1100 lines the newest 1000 stay. `show` and `last` read it; the hub is not asked.
#
# How a feed is read: `nats sub --dump DIR` writes every received message as DIR/<seq>.json
# before it acknowledges it; this script prints those files in sequence order and deletes
# them. The spool (~/.cache/fleet/<me>/<feed>) outlives the process, so a kill between the
# write and the print loses nothing: the next run prints the leftovers first. The nats CLI's
# own chatter goes to <spool>/natscli.log, never to stdout.
#
# Runs: pueue's callback on every workstation (pueue_ledger_record) publishes one JSON record
# per finished task to the stream RUNS, subject fleet.runs.<machine>.<group>:
#   {v, machine, id, group, label, command, path, created_at, start, end, duration_s,
#    result, exit_code, tail, recorded_at}
# `runs` and `run` replay the stream through a temporary consumer (nothing is consumed) and
# filter with jq. A record sent twice (a lost acknowledgement, then a resend) shows once.
#
# Config: ~/.config/fleet/agents.conf (chezmoi, encrypted): `hub nats://host:4222` and one
# `<name> <password>` line per identity. Needs the `nats` CLI (mise) and jq.

set -euo pipefail

die() {
	print -u2 -- "fleet: $*"
	exit 1
}
usage() {
	print -u2 -- "usage: fleet <me> join | who | say '#room'|@name [TEXT] | ask '#room' NAMES [TEXT] | tail dm|chan | since dm|chan [N]" \
		"| show SEQ [--json] | last dm|chan [N] [--json]" \
		"| runs [--machine M] [--group G] [--label TEXT] [--since DURATION] [--failed] [--json] [N] | run MACHINE ID [--json]"
	exit 2
}
valid() { [[ $1 =~ '^[a-z0-9][a-z0-9_-]*$' ]]; }

(($# >= 2)) || usage
me=$1 verb=$2
shift 2
valid "$me" || die "bad identity name: $me (lowercase letters, digits, _ and -)"

conf=${FLEET_CONF:-$HOME/.config/fleet/agents.conf}
[[ -r $conf ]] || die "missing $conf (chezmoi deploys it; source private_dot_config/private_fleet/encrypted_private_agents.conf.age)"
hub=$(awk '$1=="hub"{print $2; exit}' "$conf")
pw=$(awk -v n="$me" '$1==n{print $2; exit}' "$conf")
[[ -n $hub ]] || die "no hub line in $conf"
[[ -n $pw ]] || die "no password for $me in $conf"
export NATS_URL=$hub NATS_USER=$me NATS_PASSWORD=$pw
n() { nats --no-context --inbox-prefix "_INBOX_$me" "$@"; }

# A dumped message: {"Subject","Reply","Header":{"To":["a,b"]}|null,"Data":"<base64>"}.
# The read-position metadata rides in Reply: $JS.ACK.<stream>.<consumer>.<delivered>.<seq>.<cseq>.<ns>.<pending>
# RECORD turns it into the message, the line the archive keeps.
RECORD='(.Subject | split(".")) as $p
	| ((.Reply // "") | split(".")) as $r
	| {seq: ($r[5] | tonumber? // null),
	   time: (($r[7] | tonumber? // 0) / 1e9 | floor | todate),
	   from: $p[3],
	   in: (if $p[1] == "dm" then "@" + $p[2] else "#" + $p[2] end),
	   to: ((.Header.To // [""])[0] | split(",") | map(select(length > 0))),
	   text: ((.Data // "") | @base64d | sub("\n+$"; ""))}'

# RENDER turns a message into the lines printed for it; own room lines print none.
# For the monitor ($form == "monitor") the lines fit one Claude Code notification, which
# keeps 500 characters per line and 3000 in all (lines joined by newlines; lengths as
# JavaScript counts them, so a character above U+FFFF counts twice). A message whose line
# is too long becomes {…,"part":"1/N","text":…} plus {"seq":S,"part":"2/N","text":…} lines
# of at most 480 characters each, at most 2900 together. When they do not all fit, the
# last line printed is {"seq":S,"part":"k/N","cut":true,"text":"(cut: fleet <me> show S …)"}.
RENDER='def width: explode | map(if . > 65535 then 2 else 1 end) | add // 0;
	def line_max: 480;
	def burst_max: 2900;
	# how many codepoints of $c, from the start, encode within $room
	def fit($c; $room):
		if ($c | implode | tojson | width) - 2 <= $room then $c | length
		else [0, ($c | length)]
			| until(.[1] - .[0] <= 1; ((.[0] + .[1]) / 2 | floor) as $k
				| if ($c[:$k] | implode | tojson | width) - 2 <= $room then [$k, .[1]] else [.[0], $k] end)
			| .[0] end;
	def pieces($t; $room1; $room):
		($t | explode) as $c
		| {i: 0, out: []}
		| until(.i >= ($c | length);
			(if .out == [] then $room1 else $room end) as $r
			| ([fit($c[.i:.i + $r]; $r), 1] | max) as $k
			| .out += [$c[.i:.i + $k] | implode] | .i += $k)
		| .out;
	. as $m
	| def cut($part): {seq: $m.seq, part: $part, cut: true, text: "(cut: fleet \($me) show \($m.seq) prints the whole message)"};
	if .from == $me and (.in | startswith("#")) then empty
	elif $form != "monitor" or (tojson | width) <= line_max then tojson
	else
		"999999/999999" as $wide
		| pieces(.text; line_max - (. + {part: $wide, text: ""} | tojson | width);
			line_max - ({seq, part: $wide, text: ""} | tojson | width)) as $p
		| ($p | length) as $n
		| [range(0; $n) as $i
			| if $i == 0 then $m + {text: $p[0], part: "1/\($n)"} else {seq: $m.seq, part: "\($i + 1)/\($n)", text: $p[$i]} end
			| tojson] as $all
		| [foreach $all[] as $l (0; . + ($l | width) + 1)] as $sum
		| if $sum[-1] - 1 <= burst_max then $all[]
		  else ($sum | map(select(. + (cut($wide) | tojson | width) <= burst_max)) | length) as $k
			| $all[:$k][], (cut("\($k + 1)/\($n)") | tojson)
		  end
	end'

# an archived message for a human: a header line, a blank line, the text
SHOWN='def shown: "\(.seq)  \(.time)  \(.from)  \(.in)  \(if .to == [] then "-" else .to | join(",") end)", "", .text;'

spool_of() { # feed → the spool directory, created
	local d=${XDG_CACHE_HOME:-$HOME/.cache}/fleet/$me/$1
	mkdir -p "$d"
	chmod 700 "$d"
	print -- "$d"
}

archive_dir=${XDG_STATE_HOME:-$HOME/.local/state}/fleet/$me
archive_of() { # feed → the archive file, its directory created
	mkdir -p "$archive_dir"
	chmod 700 "$archive_dir"
	print -- "$archive_dir/$1.jsonl"
}

archive_add() { # file message: append the message, once; past 1100 lines keep the newest 1000
	# a spool file printed again after a kill must not add a second line
	if [[ -s $1 && $(tail -n 1 "$1") == "${2%%,*},"* ]]; then
		return 0
	fi
	print -r -- "$2" >>"$1"
	if (($(wc -l <"$1") > 1100)); then
		tail -n 1000 "$1" >"$1.tmp"
		mv -f -- "$1.tmp" "$1"
	fi
}

drain() { # spool archive [monitor]: archive, print and delete the spooled messages in stream
	# order; for the monitor only the next message, in lines that fit one notification.
	# Sets printed to the number of messages printed.
	local f rec out form=${3:-plain}
	printed=0
	for f in "$1"/<->.json(N.n); do
		# an empty file is a write in progress, like an unreadable one
		if rec=$(jq -c "$RECORD" "$f" 2>/dev/null) && [[ -n $rec ]]; then
			archive_add "$2" "$rec"
			out=$(jq -r --arg me "$me" --arg form "$form" "$RENDER" <<<"$rec") || out=$rec
			if [[ -n $out ]]; then
				print -r -- "$out"
				printed=$((printed + 1))
			fi
			rm -f -- "$f"
			if [[ $form == monitor ]] && ((printed)); then
				return 0
			fi
		elif [[ -z $f(#qNms-5) ]]; then # older than 5 s and still unreadable: not a write in progress
			print -u2 -- "fleet: unreadable spool file set aside: $f.bad"
			mv -f -- "$f" "$f.bad"
		fi
	done
}

feed_of() {
	[[ ${1:-} == dm || ${1:-} == chan ]] || usage
	print -- "$1"
}

text_of() { # the remaining arguments, else stdin
	if (($#)); then
		print -rn -- "$*"
	elif [[ ! -t 0 ]]; then
		cat
	else
		die "no text given"
	fi
}

send() { # subject [pub flags…]: the text from text_of on stdin; quiet unless it fails
	local out
	if ! out=$(n pub -J --no-templates --force-stdin "${@[2,-1]}" "$1" 2>&1); then
		die "not sent (${out##*$'\n'})"
	fi
}

# Run records carry the daemon's RFC 3339 times (a fraction and an offset; jq's own parser
# takes neither). The newest run is the one with the latest end.
RUNDEFS='def epoch:
		capture("^(?<s>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})(?<f>\\.[0-9]+)?(?<z>Z|[+-][0-9]{2}:[0-9]{2})$")
		| (.s + "Z" | fromdateiso8601) + ("0" + (.f // "") | tonumber)
		  - (if .z == "Z" then 0
		     else (if .z[0:1] == "-" then -1 else 1 end) * ((.z[1:3] | tonumber) * 3600 + (.z[4:6] | tonumber) * 60) end);
	def newest_first: unique_by([.machine, .id, .end]) | sort_by(.end | epoch? // 0) | reverse;'

replay() { # subject nats-sub-flags…: every v1 record on that subject, one JSON line each; other messages skipped
	local log=${XDG_CACHE_HOME:-$HOME/.cache}/fleet/$me/runs.log
	mkdir -p "${log:h}"
	n sub "$1" --stream RUNS "${@[2,-1]}" -T --raw --wait 3s 2>"$log" | jq -cR 'fromjson? | select(.v? == 1)' ||
		die "cannot read the RUNS stream ($(tail -n 1 "$log"))"
}

case $verb in
join)
	n kv put presence "$me" "$(hostname -s)" >/dev/null
	for feed in dm chan; do
		printf '%s waiting: %s\n' "$feed" "$(n consumer info FLEET "$me-$feed" -j | jq -r .num_pending)"
	done
	;;
who)
	for k in $(n kv ls presence 2>/dev/null | grep -E '^[a-z0-9][a-z0-9_-]*$'); do
		printf '%s\t%s\n' "$k" "$(n kv get presence "$k" --raw 2>/dev/null || true)"
	done
	;;
say)
	target=${1:-}
	(($#)) && shift
	case $target in
	'#'*)
		room=${target#'#'}
		valid "$room" || die "bad room name: $room"
		text_of "$@" | send "fleet.chan.$room.$me"
		;;
	'@'*)
		to=${target#'@'}
		valid "$to" || die "bad recipient name: $to"
		text_of "$@" | send "fleet.dm.$to.$me" -H "To:$to"
		;;
	*) usage ;;
	esac
	;;
ask)
	(($# >= 2)) || usage
	target=$1 names=$2
	shift 2
	[[ $target == '#'* ]] || die "ask takes a #room (a private message always names its recipient)"
	room=${target#'#'}
	valid "$room" || die "bad room name: $room"
	[[ $names =~ '^[a-z0-9][a-z0-9_,-]*$' ]] || die "bad NAMES: $names (a,b or a prefix like team-)"
	text_of "$@" | send "fleet.chan.$room.$me" -H "To:$names"
	;;
tail)
	feed=$(feed_of "${1:-}")
	spool=$(spool_of "$feed")
	# one tail per identity and feed on this machine: a plugin reload starts the
	# monitors again, and two readers would split the feed
	exec {lockfd}>"$spool/.lock"
	flock -n "$lockfd" || die "another 'fleet $me tail $feed' already runs on this machine (lock $spool/.lock)"
	# kill the whole tree under this process (subshell, shim, nats), not only
	# the direct children
	killtree() {
		local c
		for c in $(pgrep -P "$1" 2>/dev/null); do killtree "$c"; done
		kill "$1" 2>/dev/null || true
	}
	cleanup() {
		local c
		for c in $(pgrep -P $$ 2>/dev/null); do killtree "$c"; done
	}
	trap cleanup EXIT
	trap 'cleanup; exit 143' INT TERM HUP
	# presence heartbeat; it stops within 30 s of this process dying
	(while kill -0 $$ 2>/dev/null; do
		n kv put presence "$me" "$(hostname -s)" >/dev/null 2>&1 || true
		sleep 30
	done) &
	# the reader, restarted 5 s after every exit (hub restart, network blip)
	(while kill -0 $$ 2>/dev/null; do
		n sub --stream FLEET --durable "$me-$feed" --dump "$spool" >"$spool/natscli.log" 2>&1 || true
		sleep 5
	done) &
	archive=$(archive_of "$feed")
	# Claude Code joins the lines printed within 200 ms into one notification, and passes a
	# monitor 10 notifications at once, then one per 2 s, dropping the rest: one message
	# per notification, at most 8 at once, then one per 2.1 s; the spool holds the others
	zmodload zsh/datetime
	integer tokens=8 refills
	float since_refill=$EPOCHREALTIME
	while :; do
		refills=$(((EPOCHREALTIME - since_refill) / 2.1))
		if ((refills > 0)); then
			tokens=$((tokens + refills < 8 ? tokens + refills : 8))
			since_refill=$((since_refill + refills * 2.1))
		fi
		if ((tokens > 0)); then
			drain "$spool" "$archive" monitor
			tokens=$((tokens - printed))
		fi
		sleep 0.3
	done
	;;
since)
	feed=$(feed_of "${1:-}")
	count=${2:-20}
	[[ $count == <1-> ]] || die "N must be a positive number"
	spool=$(spool_of "$feed")
	n sub --stream FLEET --durable "$me-$feed" --dump "$spool" --count "$count" -T --wait 3s >"$spool/natscli.log" 2>&1 ||
		die "cannot read the $feed feed ($(tail -n 1 "$spool/natscli.log"))"
	drain "$spool" "$(archive_of "$feed")"
	;;
show)
	zparseopts -D -E -F -- -json=o_json || usage
	(($# == 1)) || usage
	[[ $1 == <-> ]] || die "SEQ must be a message number"
	files=("$archive_dir"/{dm,chan}.jsonl(N))
	record=
	if ((${#files})); then
		record=$(jq -cn --argjson s "$((10#$1))" 'last(inputs | select(.seq == $s)) // empty' "${files[@]}")
	fi
	[[ -n $record ]] || die "message $1 is not in this machine's archive (received elsewhere, or before the archive existed);" \
		"the server's admin can read it from stream FLEET, sequence $1"
	if ((${#o_json})); then
		print -r -- "$record"
	else
		jq -r "$SHOWN"' shown' <<<"$record"
	fi
	;;
last)
	zparseopts -D -E -F -- -json=o_json || usage
	(($# == 1 || $# == 2)) || usage
	feed=$(feed_of "$1")
	count=${2:-10}
	[[ $count == <1-> ]] || die "N must be a positive number"
	[[ -s $archive_dir/$feed.jsonl ]] || exit 0
	tail -n "$count" "$archive_dir/$feed.jsonl" |
		if ((${#o_json})); then
			cat
		else
			jq -rn "$SHOWN"'foreach inputs as $m (0; . + 1; (if . > 1 then "" else empty end), ($m | shown))'
		fi
	;;
render)
	(($# == 1)) || usage
	[[ -r $1 ]] || die "cannot read $1"
	jq -c "$RECORD" "$1" | jq -r --arg me "$me" --arg form monitor "$RENDER"
	;;
runs)
	zparseopts -D -E -F -- -machine:=o_machine -group:=o_group -label:=o_label -since:=o_since -failed=o_failed -json=o_json || usage
	(($# <= 1)) || usage
	count=${1:-20}
	[[ $count == <1-> ]] || die "N must be a positive number"
	machine=${o_machine[-1]:-} subject='fleet.runs.>'
	if [[ -n $machine ]]; then
		valid "$machine" || die "bad machine name: $machine"
		subject=fleet.runs.$machine.'>'
	fi
	records=$(replay "$subject" --since "${o_since[-1]:-30d}")
	jq -sc --arg m "$machine" --arg g "${o_group[-1]:-}" --arg l "${o_label[-1]:-}" \
		--argjson failed "$((${#o_failed} > 0))" --argjson count "$count" "$RUNDEFS"'
		map(select(($m == "" or .machine == $m) and ($g == "" or .group == $g)
			and ($l == "" or ((.label // "") | ascii_downcase | contains($l | ascii_downcase)))
			and ($failed == 0 or .result != "Success")))
		| newest_first | .[:$count][]' <<<"$records" |
		if ((${#o_json})); then
			cat
		else
			jq -r "$RUNDEFS"'
				def dur: if . == null then "-"
					elif . >= 3600 then "\(. / 3600 | floor)h\(. % 3600 / 60 | floor)m\(. % 60)s"
					elif . >= 60 then "\(. / 60 | floor)m\(. % 60)s"
					else "\(.)s" end;
				def pad($w): tostring | if length < $w then . + " " * ($w - length) else . end;
				[(.end | epoch? // null | if . then strflocaltime("%Y-%m-%d %H:%M") else "-" end),
				 (.machine | pad(10)), (.id | pad(5)), (.group | pad(8)),
				 (.result + (if .result != "Success" and .exit_code != null then " \(.exit_code)" else "" end) | pad(10)),
				 (.duration_s | dur | pad(9)), (.label // "")] | join(" ")'
		fi
	;;
run)
	zparseopts -D -E -F -- -json=o_json || usage
	(($# == 2)) || usage
	machine=$1 rid=$2
	valid "$machine" || die "bad machine name: $machine"
	[[ $rid == <-> ]] || die "ID must be a task number"
	records=$(replay "fleet.runs.$machine.>" --all)
	record=$(jq -sc --argjson id "$rid" "$RUNDEFS"'map(select(.id == $id)) | newest_first | .[0] // empty' <<<"$records")
	[[ -n $record ]] || die "no record of task $rid on $machine"
	if ((${#o_json})); then
		print -r -- "$record"
	else
		jq -r '(to_entries[] | select(.key != "tail") | "\(.key): \(.value | if type == "string" then . else tojson end)"), "", .tail' <<<"$record"
	fi
	;;
*) usage ;;
esac
