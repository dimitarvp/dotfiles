#!/usr/bin/env bash
# pueue_ledger_record — pueue's callback: one run-ledger record per finished task.
#
#   pueue_ledger_record <task id>     the callback form
#   pueue_ledger_record --flush       from a terminal shell: send the waiting records, nothing else
#
# Reads the task and the last 50 lines of its output from the daemon and builds one JSON
# line (v1): machine, id, group, label, command, path, created_at, start, end, duration_s,
# result, exit_code, tail, recorded_at. The submitting shell's environment (envs) never
# goes in. The line is appended to records.jsonl (kept on this machine for good), then
# published to the hub as fleet.runs.<machine>.<group>, signed in as the machine's identity
# (its short host name). A line the hub does not take waits in unsent.jsonl; every run
# sends those first, oldest first, and stops at the first failure.
#
# State directory: $PUEUE_LEDGER_DIR, default ~/.local/state/pueue_ledger.
# Hub config: ~/.config/fleet/agents.conf (or $FLEET_CONF), the file the fleet wrapper reads.
# The callback form always exits 0: the task is finished either way, and a callback cannot
# change it. --flush exits 1 while records still wait. On a Mac the launchd-started daemon
# cannot reach the local network, a terminal shell can, so --flush is how its records leave.

set -uo pipefail
# the daemon that spawns this runs under launchd or systemd with a bare PATH
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.local/share/mise/shims:$PATH"
export PUEUE_LEDGER_CALLBACK=1 # the macOS pueue wrapper must not start hub sends from the daemon's context

warn() { printf 'pueue_ledger_record: %s\n' "$*" >&2; }

flush_only=0
if [[ ${1:-} == --flush ]]; then
	flush_only=1
else
	id=${1:-}
	[[ $id =~ ^[0-9]+$ ]] || {
		warn "usage: pueue_ledger_record <task id> | --flush"
		exit 0
	}
fi
machine=$(hostname -s | tr "[:upper:]" "[:lower:]") # the hub identity is lowercase; some hosts report theirs in capitals
dir=${PUEUE_LEDGER_DIR:-$HOME/.local/state/pueue_ledger}

record=""
if ((flush_only == 0)); then
	if ! task=$(pueue status --json 2>/dev/null | jq -ce --arg id "$id" '.tasks[$id] | select(.status.Done != null)'); then
		warn "task $id is unknown, unfinished, or the daemon is not reachable"
		exit 0
	fi
	tail=$(pueue log --json --lines 50 "$id" 2>/dev/null | jq -r --arg id "$id" '.[$id].output // ""') ||
		warn "task $id: the log tail is not readable"
fi

# Daemon times are RFC 3339 with a fraction and an offset; jq's own parser takes neither.
RECORD='def epoch:
		capture("^(?<s>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})(?<f>\\.[0-9]+)?(?<z>Z|[+-][0-9]{2}:[0-9]{2})$")
		| (.s + "Z" | fromdateiso8601) + ("0" + (.f // "") | tonumber)
		  - (if .z == "Z" then 0
		     else (if .z[0:1] == "-" then -1 else 1 end) * ((.z[1:3] | tonumber) * 3600 + (.z[4:6] | tonumber) * 60) end);
	.status.Done as $d
	| $d.result as $r
	| (if $r == "Success" then ["Success", 0]
	   elif ($r | type) == "object" then [($r | keys_unsorted[0]), ($r.Failed // null)]
	   else [$r, null] end) as [$result, $code]
	| {v: 1, machine: $machine, id, group, label, command, path, created_at,
	   start: $d.start, end: $d.end,
	   duration_s: (try ([($d.end | epoch) - ($d.start | epoch)] | .[0] | round) catch null),
	   result: $result, exit_code: $code, tail: $tail, recorded_at: (now | floor | todate)}'
if ((flush_only == 0)); then
	record=$(jq -c --arg machine "$machine" --arg tail "${tail:-}" "$RECORD" <<<"$task") || {
		warn "task $id: the record could not be built"
		exit 0
	}
fi

mkdir -p "$dir"
unsent=$dir/unsent.jsonl
# two tasks can finish at once; one writer at a time keeps the files whole and sends nothing twice
exec {lock}>>"$dir/.lock"
flock "$lock"
[[ -z $record ]] || printf '%s\n' "$record" >>"$dir/records.jsonl"

conf=${FLEET_CONF:-$HOME/.config/fleet/agents.conf}
hub=$(awk '$1=="hub"{print $2; exit}' "$conf" 2>/dev/null)
pw=$(awk -v n="$machine" '$1==n{print $2; exit}' "$conf" 2>/dev/null)
export NATS_URL=$hub NATS_USER=$machine NATS_PASSWORD=$pw
[[ -n $hub && -n $pw ]] || warn "no hub line or no password for $machine in $conf; the record waits in $unsent"

hub_error=""
publish() { # one record line → fleet.runs.<machine>.<group>; the hub's last error line stays in hub_error
	local subject out
	[[ -n $hub && -n $pw ]] || return 1
	subject=$(jq -r '"fleet.runs.\(.machine).\(.group | gsub("[^A-Za-z0-9_-]"; "_"))"' <<<"$1") || return 1
	if ! out=$(printf '%s' "$1" |
		nats --no-context --inbox-prefix "_INBOX_$machine" --timeout 10s pub -J --no-templates --force-stdin "$subject" 2>&1); then
		hub_error=${out##*$'\n'}
		return 1
	fi
}

pending=()
[[ -s $unsent ]] && mapfile -t pending <"$unsent"
[[ -z $record ]] || pending+=("$record")
left=()
for line in "${pending[@]}"; do
	[[ -n $line ]] || continue
	if ((${#left[@]} == 0)) && publish "$line"; then
		continue
	fi
	left+=("$line")
done
if ((${#left[@]})); then
	printf '%s\n' "${left[@]}" >"$unsent.tmp" && mv -f -- "$unsent.tmp" "$unsent"
	warn "the hub did not take ${#left[@]} record(s); they wait in $unsent${hub_error:+ ($hub_error)}"
else
	rm -f -- "$unsent"
fi
if ((flush_only)); then
	printf 'pueue_ledger_record: sent %d record(s), %d waiting\n' "$((${#pending[@]} - ${#left[@]}))" "${#left[@]}"
	((${#left[@]} == 0)) || exit 1
fi
exit 0
