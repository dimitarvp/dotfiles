#!/bin/zsh
# rfetch URL OUTFILE — read one web page through the research browser on the server.
# Runs the fetch on the server over one ssh session and receives the result files back: OUTFILE holds the HTML (or the
# downloaded file as-is), OUTFILE.txt the visible text. The ssh connection is shared for ten minutes
# so a wave of fetches pays for one login. Exit codes are the fetch's own: 0 page read; 2 still behind
# a bot wall after 90 s (files written anyway); 3 browser not running (ask the coordinator for
# `research_browser up`); 4 no free slot within 100 s, here or in the browser (retry in a minute); 6 navigation failed.
set -u
URL=${1:?usage: rfetch URL OUTFILE}
OUT=${2:?usage: rfetch URL OUTFILE}
HOST=s1
SSH=(ssh -n -o BatchMode=yes -o ConnectTimeout=15 -o ControlMaster=auto -o ControlPersist=600 -o "ControlPath=$HOME/.ssh/cm-rfetch-%r@%h:%p")
name="rf-$(/bin/date +%s)-$$-$RANDOM-${${OUT:t}//[^A-Za-z0-9._-]/_}"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/rfetch.XXXXXX") || exit 6
# at most SLOTS fetches in flight from this machine, waited for here, before any ssh session is opened:
# the browser has that many slots anyway, and sshd allows ten sessions per shared connection
SLOTS=3
SLOTBASE="${TMPDIR:-/tmp}/rfetch-slots"
mkdir -p "$SLOTBASE"
slot=""
waited=0
while [[ -z $slot ]]; do
	for i in {1..$SLOTS}; do
		cand="$SLOTBASE/$i"
		if [[ -d $cand ]] && (($(/bin/date +%s) - $(/usr/bin/stat -f %m "$cand") > 300)); then
			rmdir "$cand" 2>/dev/null
		fi
		if mkdir "$cand" 2>/dev/null; then
			slot=$cand
			break
		fi
	done
	[[ -n $slot ]] && break
	if ((waited >= 100)); then
		echo "rfetch: all $SLOTS fetch slots busy for 100 s; retry in a minute" >&2
		rm -rf "$tmp"
		exit 4
	fi
	sleep 2
	waited=$((waited + 2))
done
trap 'rmdir "$slot" 2>/dev/null; rm -rf "$tmp"' EXIT INT TERM
# one ssh session per fetch: the server streams the result files back as a tar on stdout
"${SSH[@]}" "$HOST" "research_browser fetch ${(q)URL} ${(q)name}" | tar -x -C "$tmp" 2>/dev/null
rc=$pipestatus[1]
if ((rc == 0 || rc == 2)); then
	if [[ -e $tmp/$name ]]; then
		mv -f "$tmp/$name" "$OUT"
	else
		echo "rfetch: the server reported a read but sent no file" >&2
		rc=6
	fi
	[[ -e $tmp/$name.txt ]] && mv -f "$tmp/$name.txt" "$OUT.txt"
fi
exit $rc
