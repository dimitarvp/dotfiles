# Exclusions for treesync (unison) between the workstations and the hub.
# Every line is a NAME. It matches a file or directory with that name at ANY
# depth under ~/w, ~/kod and ~/ow, regardless of git: a git-tracked file with
# one of these names never leaves the machine that has it, and the checkouts on
# the other machines show it as deleted. Before adding a name, check that no
# repo tracks files by it (git ls-files across the synced trees). Before naming
# a result file that must travel, check it against this list. A pattern with a
# slash inside is not supported; treesync refuses it.
# Include .git (full history), PDFs, PNGs, HTMLs. Exclude only build artifacts
# and regenerable content.

# OS junk
.DS_Store
.Spotlight-V100
.fseventsd
Thumbs.db

# Elixir/Erlang build artifacts
_build/
deps/
cover/
.elixir_ls/
.expert/
.lexical/
.fetch/
.sobelow/
erl_crash.dump
Mnesia.*
*.plt
*.ez
*.beam
*.ets
*.dump

# Erlang/OTP release artifacts
_deploy/

# Rust build artifacts
target/

# Node/JS build artifacts
node_modules/
dist/
build/
*.bundle.js
*.min.js
*.min.css
*.js.map
*.css.map
*.min.css.map

# Go build artifacts (binaries have no extension — delete manually)

# Compiled objects
*.o
*.a
*.so
*.dll
*.zwc

# Caches
.cache/
tmp/
*.log

# Live per-machine session state — churns mid-transfer, meaningless elsewhere
.watch_cursors/

# Per-machine trash: trash.sh parks superseded files here; never travels
.trash/
