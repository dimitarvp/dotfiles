#!/bin/zsh
# Parallel implementation of update_all via go-task (see update.taskfile.yml).
# Parity period: update_all stays canonical until it is retired.
# Each run logs to ~/.local/state/update_via_gotask/ (last 30 kept) so the
# lane's success can be judged from evidence, not memory.
#
# Terminal vs log: task runs with --verbose because only that names every
# failed task (without it the final error names one failure chain), and with
# --output prefixed so every step line carries "[step] " in the run log. The
# run log keeps that full stream; the terminal gets tool output and failures
# only: the "[step] " prefix, task's command echo, its started/finished
# markers and its "skipping execution" notes (run: once dedup — a second
# caller waiting for the one execution, nothing skipped) are filtered out.
# The filter matches whole lines, so every taskfile command must be a
# one-liner (multi-line bodies live in scripts). Step lines (stdout) and
# task's own lines (stderr) take separate pipes: task writes a step line in
# four pieces ("[", step, "] ", text), and on a shared pipe its own lines land
# between them. The log has one writer, so task's own lines follow the step
# lines there: a second writer cuts lines longer than its 4 KiB buffer.
#
# A failed run ends with a block, on the terminal and in the log, that names
# each failed step and repeats what went wrong: for the server's health step
# the ERROR lines with their detail lines and the summary line, for any other
# step its last 20 lines.
#
# In the run log every line of the run starts with the seconds since the run
# began ("   42s "), taken when the line arrived, so the log shows which step
# and which command took the time. The terminal shows no times. The clock is
# read with awk's srand(), which every awk has: called twice without an
# argument, the second call returns the time the first one took as its seed.

unset GOROOT
unsetopt multios

LOGDIR="$HOME/.local/state/update_via_gotask"
mkdir -p "$LOGDIR"
LOG="$LOGDIR/run-$(date +%Y%m%d-%H%M%S).log"

# No `sudo -v` priming here: each step calls sudo itself.

# the run log's only writer: every line whole into the log behind its seconds; step lines also to the terminal without
# their "[step] " prefix. Task's own lines arrive from task_lines at the end with their seconds already on them.
log_steps() {
	awk -v lf="$LOG" -v t0="$START" '/^ *[0-9]+s task: / { print >> lf; fflush(lf); next }
		{ srand(); printf "%5ds %s\n", srand() - t0, $0 >> lf; fflush(lf); sub(/^\[[^]]+\] /, ""); print; fflush() }'
}
# task's own lines: to the terminal without the chatter while task runs, all of them on to log_steps (fd 3) once task has
# ended, each behind the seconds at which it arrived
task_lines() {
	awk -v t0="$START" '!/^task: (\[|"[^"]*" (started|finished)$|skipping execution of task: )/ { print; fflush() }
		{ srand(); all = all sprintf("%5ds ", srand() - t0) $0 "\n" } END { printf "%s", all > "/dev/fd/3" }'
}

# each step the run log names as failed, with the lines that say what went wrong
failed_steps() {
	local f name st lines hits
	local -a failed=(${(f)"$(sed -nE 's/^ *[0-9]+s task: "([^"]+)" failed: exit status ([0-9]+)$/\1 \2/p' "$LOG")"})
	((${#failed})) || return
	print "════ failed steps ════"
	for f in $failed; do
		name=${f% *} st=${f##* }
		lines=$(awk -v p="[$name] " '{ sub(/^ *[0-9]+s /, "") } index($0, p) == 1 { print substr($0, length(p) + 1) }' "$LOG")
		[[ -n $lines ]] || lines="(no output)"
		hits=
		[[ $name == health ]] && hits=$(print -r -- "$lines" |
			awk '/^ *ERROR / { e = 1; print; next } e && /^          / { print; next } { e = 0 } /^[a-z0-9]+_health: / { s = $0 } END { if (s != "") print s }')
		print "$name: exit status $st"
		print -r -- "${hits:-$(print -r -- "$lines" | tail -n 20)}" | sed 's/^/    /'
	done
}

print "════ update_via_gotask $(date -u +%FT%TZ) target=${*:-update} ════" >>"$LOG"
t0=$SECONDS
START=$(date +%s)
exec 4>&1
{
	task --taskfile "$HOME/scripts/update.taskfile.yml" --verbose --output prefixed "${@:-update}" 2>&1 1>&3 3>&- | task_lines >&4
	exit $pipestatus[1]
} 3>&1 | log_steps
rc=$pipestatus[1]
exec 4>&-
if ((rc)); then
	block=$(failed_steps)
	[[ -n $block ]] && print -r -- "$block" | tee -a "$LOG"
fi
print "════ exit=$rc duration=$((SECONDS - t0))s ════" >>"$LOG"
ls -1t "$LOGDIR"/run-*.log 2>/dev/null | tail -n +31 | xargs rm -f 2>/dev/null
exit $rc
